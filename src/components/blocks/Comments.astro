---
import site from "@/config/site";

const { enabled, provider, giscus } = site.comments;

const configured = Boolean(
  giscus.repo && giscus.repoId && giscus.category && giscus.categoryId,
);
const giscusEnabled = enabled && provider === "giscus" && configured;
const showHint =
  enabled && provider === "giscus" && !configured && import.meta.env.DEV;
---

{
  giscusEnabled && (
    <div class="animate-in fade-in duration-1000">
      <div
        class="giscus"
        id="giscus-comments"
        data-repo={giscus.repo}
        data-repo-id={giscus.repoId}
        data-category={giscus.category}
        data-category-id={giscus.categoryId}
        data-mapping={giscus.mapping}
        data-term={giscus.term}
        data-strict={giscus.strict ? "1" : "0"}
        data-reactions-enabled={giscus.reactionsEnabled ? "1" : "0"}
        data-emit-metadata={giscus.emitMetadata ? "1" : "0"}
        data-input-position={giscus.inputPosition}
        data-lang={giscus.lang}
        data-light-theme={giscus.lightTheme}
        data-dark-theme={giscus.darkTheme}
      />
    </div>
  )
}

{
  showHint && (
    <div class="rounded-2xl border border-dashed border-border/60 bg-muted/20 px-6 py-5 text-sm text-muted-foreground">
      giscus 尚未配置：请到{" "}
      <a
        class="text-primary hover:underline"
        href="https://giscus.app"
        target="_blank"
        rel="noopener"
      >
        giscus.app
      </a>{" "}
      生成配置，并填写到 <code>src/config/site.ts</code> 的{" "}
      <code>comments.giscus</code>（repoId / category / categoryId）。
    </div>
  )
}

<script>
  const GISCUS_ORIGIN = "https://giscus.app";
  const GISCUS_CLIENT = `${GISCUS_ORIGIN}/client.js`;
  const INTERNAL_DATASET_KEYS = ["loaded", "lightTheme", "darkTheme"];

  function giscusContainer(): HTMLElement | null {
    const el = document.querySelector("#giscus-comments");
    return el instanceof HTMLElement ? el : null;
  }

  function giscusFrame(): HTMLIFrameElement | null {
    const iframe = document.querySelector("iframe.giscus-frame");
    return iframe instanceof HTMLIFrameElement ? iframe : null;
  }

  function themeFor(el: HTMLElement): string {
    const isDark = document.documentElement.classList.contains("dark");
    return (
      (isDark ? el.dataset.darkTheme : el.dataset.lightTheme) ||
      (isDark ? "dark" : "light")
    );
  }

  // giscus loads the theme as a stylesheet URL from inside its own iframe
  // (https://giscus.app), so resolve site-relative paths (e.g.
  // "/giscus-theme-light.css") against the deployed origin.
  function resolveTheme(theme: string): string {
    return theme.startsWith("/")
      ? new URL(theme, window.location.origin).href
      : theme;
  }

  // Keep the giscus theme in sync with the site's light/dark toggle.
  function syncTheme() {
    const el = giscusContainer();
    const iframe = giscusFrame();
    if (!el || !iframe) return;
    iframe.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: resolveTheme(themeFor(el)) } } },
      GISCUS_ORIGIN,
    );
  }

  // Fill in the comment counter in post headers from giscus metadata
  // (requires `giscus.emitMetadata` to be enabled).
  function handleMessage(event: MessageEvent) {
    if (event.origin !== GISCUS_ORIGIN) return;
    const data: unknown = event.data;
    if (!(data && typeof data === "object" && "giscus" in data)) return;
    const payload = (data as { giscus: unknown }).giscus;
    if (!(payload && typeof payload === "object")) return;

    if ("error" in payload && typeof payload.error === "string") {
      console.warn("[giscus]", payload.error);
      return;
    }

    if (!("discussion" in payload)) return;
    const discussion = payload.discussion as {
      totalCommentCount?: number;
    } | null;
    const count = discussion?.totalCommentCount;
    if (typeof count !== "number") return;
    document.querySelectorAll(".giscus-comment-count").forEach((node) => {
      node.textContent = String(count);
    });
  }

  function setupComments() {
    const el = giscusContainer();
    if (!el || el.dataset.loaded === "true") return;
    el.dataset.loaded = "true";

    const script = document.createElement("script");
    script.src = GISCUS_CLIENT;
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-theme", resolveTheme(themeFor(el)));

    for (const [key, value] of Object.entries(el.dataset)) {
      if (!value || INTERNAL_DATASET_KEYS.includes(key)) continue;
      const attr = key.replace(/[A-Z]/g, (char) => `-${char.toLowerCase()}`);
      script.setAttribute(`data-${attr}`, value);
    }

    el.appendChild(script);
  }

  window.addEventListener("message", handleMessage);
  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });

  document.addEventListener("astro:page-load", () => {
    void setupComments();
  });

  if (document.readyState !== "loading") {
    void setupComments();
  } else {
    document.addEventListener("DOMContentLoaded", () => {
      void setupComments();
    });
  }
</script>
